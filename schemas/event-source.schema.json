        "code": {
          "type": "string",
          "description": "赛事方常用球队缩写或短码，如 LAL、ARS"
        },
        "name": {
          "type": "string",
          "description": "球队展示名"
        },
        "name_en": {
          "type": "string",
          "description": "球队英文名"
        },
        "image_url": {
          "type": "string",
          "format": "uri",
          "description": "球队 logo URL（电竞等外部数据源可选）"
        }
      },
      "additionalProperties": false
    }
  }
